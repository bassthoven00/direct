generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // For connection pooling (PgBouncer)
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  firstName     String
  lastName      String
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  addresses     Address[]
  refreshTokens RefreshToken[]
  reviews       Review[]
  auditLogs     AuditLog[]
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String  @id @default(cuid())
  userId    String?
  label     String?           // "Home", "Office", …
  line1     String
  line2     String?
  city      String
  state     String
  country   String  @default("US")
  zipCode   String?
  phone     String?

  user      User?    @relation(fields: [userId], references: [id])
  orders    Order[]
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  categoryId    String
  basePrice     Int            // cents (USD)
  currency      String         @default("USD")
  isActive      Boolean        @default(true)
  images        ProductImage[]
  variants      ProductVariant[]
  category      Category       @relation(fields: [categoryId], references: [id])
  reviews       Review[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id            String     @id @default(cuid())
  productId     String
  sku           String     @unique
  name          String     // e.g. "Black / XL"
  priceOverride Int?       // cents; null → use basePrice
  currency      String     @default("USD")
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory?
  orderItems    OrderItem[]
  cartItems     CartItem[]
}

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  quantityOnHand    Int            @default(0)
  lowStockThreshold Int            @default(5)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt         DateTime       @updatedAt
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique // Cookie session ID for guest carts
  userId    String?    // Nullable if guest
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  items     CartItem[]
}

model CartItem {
  id           String             @id @default(cuid())
  cartId       String
  type         String             // "product" | "experience"
  variantId    String?
  packageId    String?
  quantity     Int                @default(1)
  priceSnap    Int                // snapshot of price (cents) at add time
  submittedData Json?             // for experience packages
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  cart         Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant      ProductVariant?    @relation(fields: [variantId], references: [id])
  package      ExperiencePackage? @relation(fields: [packageId], references: [id])
}

// ─── Experience Packages ──────────────────────────────────────────────────────

model ExperiencePackage {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?
  price          Int                 // cents (USD)
  currency       String              @default("USD")
  isActive       Boolean             @default(true)
  deliveryInfo   String?             // "Delivered within 7 days"
  requiredFields Json                // drives dynamic form + validation
  imageUrl       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  addOns         PackageAddOn[]
  requests       ExperienceRequest[]
  cartItems      CartItem[]
  reviews        Review[]
}

model PackageAddOn {
  id          String            @id @default(cuid())
  packageId   String
  name        String
  description String?
  price       Int               // cents
  isActive    Boolean           @default(true)
  package     ExperiencePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model ExperienceRequest {
  id              String                  @id @default(cuid())
  packageId       String
  orderId         String?
  orderItemId     String?                 @unique
  status          ExperienceRequestStatus @default(PENDING_PAYMENT)
  submittedData   Json                    // fan's answers to requiredFields
  adminNotes      String?
  deliverableUrl  String?
  deliverableType String?                 // "video", "link", "file", …
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  package   ExperiencePackage @relation(fields: [packageId], references: [id])
  order     Order?            @relation(fields: [orderId], references: [id])
  orderItem OrderItem?        @relation(fields: [orderItemId], references: [id])
  media     Media[]
}

enum ExperienceRequestStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  REJECTED
  CANCELLED
  REFUNDED
}

// ─── Orders & Payments ────────────────────────────────────────────────────────

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique // e.g. "DIR-20250615-A3F2"
  idempotencyKey    String?     @unique // From client request to prevent duplicate orders
  userId            String?
  guestEmail        String?
  guestPhone        String?
  guestName         String?
  status            OrderStatus @default(PENDING_PAYMENT)
  subtotalAmount    Int         // cents
  totalAmount       Int         // cents
  currency          String      @default("USD")
  shippingAddressId String?
  couponId          String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user            User?              @relation(fields: [userId], references: [id])
  shippingAddress Address?           @relation(fields: [shippingAddressId], references: [id])
  coupon          Coupon?            @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  experiences     ExperienceRequest[]
  shipments       Shipment[]
  notifications   Notification[]
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  variantId         String?           // null for experience items
  experienceId      String?           // package ID for experience items
  quantity          Int               @default(1)
  unitPrice         Int               // cents
  currency          String            @default("USD")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant?   @relation(fields: [variantId], references: [id])
  experienceRequest ExperienceRequest?
}

enum FulfillmentStatus {
  UNFULFILLED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

// Payment.provider can be "stripe" | "paystack" | "paypal" | "cashapp"
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String        @default("stripe")
  providerRef   String?       @unique // provider transaction reference (opaque) - uniquely identifies a payment attempt
  providerTxId  String?       // provider transaction ID from verify/webhook
  amount        Int           // cents
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  providerMeta  Json?         // raw provider response for audit
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  providerRefundId String   @unique
  amount           Int      // cents
  currency         String   @default("USD")
  reason           String?
  status           String   @default("pending") // e.g. "pending", "succeeded", "failed"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
}

// WebhookEvent idempotency log — (provider, providerEventId) must be unique
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    // "stripe", "paystack", "paypal", "cashapp"
  providerEventId String    // e.g. Stripe evt_xxx
  eventType       String    // e.g. "charge.succeeded"
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId], name: "provider_providerEventId")
}

// ─── Logistics & Media ────────────────────────────────────────────────────────

model Shipment {
  id             String   @id @default(cuid())
  orderId        String
  trackingNumber String?
  carrier        String?
  status         String   @default("processing")
  shippedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model Media {
  id                  String             @id @default(cuid())
  url                 String
  type                String             // "image", "video", "document"
  experienceRequestId String?
  isPublic            Boolean            @default(false)
  createdAt           DateTime           @default(now())
  
  experienceRequest   ExperienceRequest? @relation(fields: [experienceRequestId], references: [id])
}

// ─── Marketing & Content ──────────────────────────────────────────────────────

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   // "percentage" | "fixed"
  discountValue Int      // cents if fixed, percentage (0-100) if percentage
  maxUses       Int?
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  orders        Order[]
}

model Review {
  id                  String             @id @default(cuid())
  userId              String?
  productId           String?
  experiencePackageId String?
  rating              Int                // 1-5
  content             String?
  isApproved          Boolean            @default(false)
  createdAt           DateTime           @default(now())

  user              User?              @relation(fields: [userId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  experiencePackage ExperiencePackage? @relation(fields: [experiencePackageId], references: [id])
}

model ContentBlock {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "homepage-hero", "faq-1"
  type      String   // "html", "text", "json"
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  orderId   String?
  type      String   // "email", "sms"
  status    String   // "pending", "sent", "failed"
  payload   Json
  error     String?
  createdAt DateTime @default(now())

  order     Order?   @relation(fields: [orderId], references: [id])
}

// ─── System ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "CREATE_PRODUCT", "UPDATE_ORDER", etc.
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model Settings {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
