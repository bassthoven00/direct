# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/direct_platform?pgbouncer=true
# Direct URL for Prisma migrations when using connection pooling
DIRECT_URL=postgresql://user:password@localhost:5432/direct_platform

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Auth — generate strong random secrets before deploying
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_DOMAIN=localhost

# ─── Payment Providers ─────────────────────────────────
# Active providers — comma-separated list; first listed is the default displayed to fans
# Supported values: stripe, paypal, cashapp, paystack
PAYMENT_PROVIDERS=stripe,paypal,cashapp,paystack

# Stripe (primary / USD)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Use "sandbox" for dev, "live" for production
PAYPAL_MODE=sandbox

# CashApp Pay (via Afterpay/Square)
CASHAPP_CLIENT_ID=
CASHAPP_CLIENT_SECRET=
CASHAPP_WEBHOOK_SECRET=

# Paystack (NGN fallback / international)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ─── Storage (Cloudflare R2 / S3-compatible) ───────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ─── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Direct <hello@yourdomain.com>"

# ─── Monitoring ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
